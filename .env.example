# ---------------------------------------------------------------------------
# GraphIntel OSINT — copy to .env and edit. .env is git-ignored.
#   cp .env.example .env && sed -i "s|^SECRET_KEY=.*|SECRET_KEY=$(openssl rand -hex 32)|" .env
# ---------------------------------------------------------------------------

# Runtime -------------------------------------------------------------------
ENV=development                 # development | test | production
DEBUG=false

# REQUIRED. At least 32 characters. Production refuses to boot with the default.
SECRET_KEY=change-me-in-production-change-me-in-production

# Storage -------------------------------------------------------------------
POSTGRES_PASSWORD=graphintel
# Only needed outside docker compose; compose builds this URL itself.
# DATABASE_URL=postgresql+asyncpg://graphintel:graphintel@localhost:5432/graphintel
# Leave REDIS_URL empty to run scans inline in the API process (no worker needed).
# REDIS_URL=redis://localhost:6379/0

# Ports ---------------------------------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Web security --------------------------------------------------------------
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
API_RATE_LIMIT_PER_MINUTE=240
ALLOW_REGISTRATION=true         # set false once your accounts exist

# Egress guard --------------------------------------------------------------
# Never enable in production: it disables private-range protection and the
# settings validator will refuse to start.
ALLOW_PRIVATE_NETWORKS=false
ALLOWED_EGRESS_PORTS=80,443
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_BYTES=4194304

# Investigation budgets (guards against graph explosion) ---------------------
MAX_DEPTH=3
MAX_ENTITIES=500
MAX_JOBS=100

# Providers -----------------------------------------------------------------
# Optional. Raises the GitHub public-API rate limit; a read-only token is enough.
GITHUB_TOKEN=
# Optional. A SearxNG instance you are permitted to query, e.g. http://searx:8080
SEARX_BASE_URL=
# Optional external CLIs; each degrades to "unavailable" when not installed.
MAIGRET_BINARY=maigret
SHERLOCK_BINARY=sherlock
HOLEHE_BINARY=holehe
EXTERNAL_TOOL_TIMEOUT_SECONDS=180
PROVIDER_CACHE_TTL_SECONDS=21600

# AI layer (entirely optional; off by default) -------------------------------
AI_ENABLED=false
LLM_PROVIDER=none               # none | ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5

# Self-OSINT: connect your own Instagram account -----------------------------
# These identify *your Meta app*, not any Instagram account. Each user of this
# deployment authorises their own account through it and receives their own
# token; nothing is shared between users.
#
# Create a Meta app at developers.facebook.com, add the product
# "Instagram API with Instagram Login", and copy its Instagram app ID/secret.
# Requires an Instagram Business or Creator account - Meta's API does not
# support personal accounts. Leave these blank to keep the feature switched off.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must match a redirect URI registered on the Meta app, character for character.
INSTAGRAM_REDIRECT_URI=http://localhost:8080/self-osint/instagram/callback
# instagram_business_basic covers profile + media. Add
# instagram_business_manage_comments to include comments on your own posts.
INSTAGRAM_SCOPES=instagram_business_basic
# Meta moves both of these; they are settings so a documented API change does
# not require a code change.
INSTAGRAM_API_VERSION=v23.0
INSTAGRAM_GRAPH_HOST=https://graph.instagram.com
OAUTH_STATE_TTL_SECONDS=600
SELF_OSINT_SYNC_COOLDOWN_SECONDS=120

# Credential encryption ------------------------------------------------------
# Optional. Url-safe base64 of exactly 32 bytes:
#   python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
# When unset, the key is derived from SECRET_KEY with HKDF under a
# purpose-specific info string. Set it to rotate credential encryption
# independently of JWT signing. Rotating either invalidates stored OAuth
# tokens by design - users simply reconnect.
TOKEN_ENCRYPTION_KEY=
